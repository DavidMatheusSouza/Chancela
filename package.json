{
  "name": "trustagent",
  "private": true,
  "version": "0.1.0",
  "description": "Identity, Authorization and Accountability for AI Agents. The IAM layer for the autonomous AI era.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.10.0" },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** build && pnpm --filter=@trustagent/web build",
    "dev": "pnpm --filter=@trustagent/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:security": "pnpm --filter=@trustagent/policy-engine test:security",
    "lint": "pnpm -r lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "contracts:build": "pnpm --filter=@trustagent/contracts build",
    "contracts:test": "pnpm --filter=@trustagent/contracts test",
    "verify:all": "pnpm typecheck && pnpm test && pnpm contracts:test"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
