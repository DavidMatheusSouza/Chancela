# ─────────────────────────────────────────────────────────────────────────────
# TrustAgent configuration
#
# Copy to .env and fill in. NOTHING in this file may ever be committed with
# real values -- .gitignore excludes .env, and CI runs gitleaks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Attestation ──────────────────────────────────────────────────────────────
# Signs authorization capsules. Generate with:  cast wallet new
#
# This key MUST NOT be any agent's operating wallet key. An agent that can sign
# its own authorizations proves nothing, and TrustAgentPolicyRegistry rejects
# the configuration on-chain via setAttestor().
ATTESTATION_PRIVATE_KEY=

# ── Monad ────────────────────────────────────────────────────────────────────
# 10143 = testnet (default for development), 143 = mainnet.
NEXT_PUBLIC_CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed by: pnpm --filter @trustagent/contracts deploy:testnet
POLICY_REGISTRY_ADDRESS=

# ERC-8004 Identity Registry.
# Mainnet (143): 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Testnet (10143): no address is published -- set it explicitly or deploy your own.
ERC8004_IDENTITY_REGISTRY=

# Deployment only. Never the same key as ATTESTATION_PRIVATE_KEY.
DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Leave unset to run fully in memory (seeded demo data, zero infrastructure).
DATABASE_URL=

# ── AI providers ─────────────────────────────────────────────────────────────
# All optional. With none set, the deterministic keyword parser is used and the
# product still runs end to end. A missing key degrades intent quality --
# never authorization.
AI_PROVIDER=auto

QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Free providers: no card, no spend ────────────────────────────────────────
# Either one restores real intent parsing and the provider-swap demo at zero
# cost. The deterministic `rules` provider always works without any of these.
# Groq:       https://console.groq.com  (free tier, no card)
GROQ_API_KEY=
GROQ_MODEL=
# OpenRouter: https://openrouter.ai/keys (free models carry a :free suffix)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Paid. Kimi has no permanent free tier and needs a $1 top-up.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.ai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Sponsor integrations ─────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

NEXT_PUBLIC_MERA_ENABLED=false

ENVIO_GRAPHQL_URL=

# Without a key, counterparty risk falls back to a local denylist. It never
# falls back to "no signals, all clear".
NANSEN_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, used for login redirects and link previews. Required behind
# a tunnel or reverse proxy, where the process only sees its loopback bind.
PUBLIC_BASE_URL=
PORT=3080
DEMO_OWNER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Enables "Continue as demo owner" outside development. The demo path goes
# through the identical signature + ownership verification; it skips nothing.
ALLOW_DEV_SIGNIN=false
